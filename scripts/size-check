#!/usr/bin/env python3
"""Size budgets for the skills an agent reads whole: a door it loads is context it pays for every time.

Each `SKILL.md`, `README.md` and each Markdown file under `references/` (recipes too) of the checked
skills must stay under its budget in bytes. A file over budget prints as `<path>: <bytes> bytes, budget <budget>` and the
check exits 1. `--top N` also prints the N largest checked files.

Usage:
    scripts/size-check [--root DIR] [--top N]

Python 3 standard library only.
"""
import argparse
import os
import sys

SKILLS = ("streams", "roadmap")
BUDGET = 16 * 1024
# Files with their own budget, by path relative to the skill's directory.
OWN_BUDGET = {"references/status.md": 24 * 1024}


def checked_files(root):
    """(path relative to root, budget) for every file the budgets cover, sorted by path."""
    found = []
    for skill in SKILLS:
        base = os.path.join(root, "skills", skill)
        if not os.path.isdir(base):
            continue
        for top in ("SKILL.md", "README.md"):
            if os.path.isfile(os.path.join(base, top)):
                found.append((os.path.join("skills", skill, top), BUDGET))
        refs = os.path.join(base, "references")
        for here, _dirs, files in os.walk(refs):
            for name in files:
                if not name.endswith(".md"):
                    continue
                inside = os.path.relpath(os.path.join(here, name), base)
                found.append((os.path.join("skills", skill, inside), OWN_BUDGET.get(inside, BUDGET)))
    return sorted(found)


def check(root):
    """(over, sizes): files at or over budget as (path, size, budget), and every checked (path, size)."""
    over, sizes = [], []
    for rel, budget in checked_files(root):
        size = os.path.getsize(os.path.join(root, rel))
        sizes.append((rel, size))
        if size >= budget:
            over.append((rel, size, budget))
    return over, sizes


def main(argv=None):
    ap = argparse.ArgumentParser(prog="size-check", description="Size budgets for the skills' Markdown.")
    ap.add_argument("--root", default=os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    ap.add_argument("--top", type=int, default=0, metavar="N", help="also print the N largest files")
    a = ap.parse_args(argv)
    over, sizes = check(a.root)
    if not sizes:
        print(f"size-check: no files found under {a.root}/skills", file=sys.stderr)
        return 1
    for rel, size in sorted(sizes, key=lambda x: -x[1])[:a.top]:
        print(f"{size:>7}  {rel}")
    for rel, size, budget in over:
        print(f"{rel}: {size} bytes, budget {budget}")
    if over:
        print(f"size-check: {len(over)} file(s) over budget", file=sys.stderr)
        return 1
    print(f"size-check: {len(sizes)} files within budget")
    return 0


if __name__ == "__main__":
    sys.exit(main())
